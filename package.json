{
  "name": "running-assistant",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Progressive running coach: VDOT-based pace zones, periodized plans, deterministic adaptation.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "fast-xml-parser": "^5.11.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "jest": "~30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  }
}
