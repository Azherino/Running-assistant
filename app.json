{
  "expo": {
    "name": "Running Assistant",
    "slug": "running-assistant",
    "scheme": "runningassistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.runningassistant.app"
    },
    "android": {
      "package": "com.runningassistant.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0C0F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
